# Exclude virtual environments
venv/
env/
__pycache__/
*.pyc

# Exclude large multimedia files
*.mp4
*.mp3
*.wav
*.webm
*.avi
*.mkv
*.mov

# Exclude temp files generated by the app
temp_*

# Do NOT exclude model_cache/ because we want the Docker image 
# to have the model pre-downloaded for instant startup!
